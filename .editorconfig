root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

# CA1028: 列挙型の基底型はbyteに統一する（ADR-0005、ADR-0009）。MatchStateとPlayerStateの
# 詰め物なしレイアウトが基底型byteに依存するため、既定のintへの変更は提案しない。
dotnet_diagnostic.CA1028.severity = none

# CA1711: PlayerFlagsは設計書（01-data-structures.md）で確定した型名で、Flags語尾の変更は提案しない。
dotnet_diagnostic.CA1711.severity = none

[tests/**/*.cs]
# CA1307: テストの固定文字列に対するstring.Replaceの文化非依存性は無関係なため抑制する。
dotnet_diagnostic.CA1307.severity = none

[src/Game/**/*.cs]
# CA2000、CA2213: GodotのNodeはAddChildで親に渡した時点で寿命をシーンツリーが管理し、
# 手動のDisposeやIDisposableパターンはGodotの流儀に合わない（03-screens-and-e2e.md）。
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA2213.severity = none

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
