#!/usr/bin/env sh
set -eu
# core.hooksPathが絶対パスだと$0は本体のチェックアウトを指し、worktreeのコミットで本体を検査してしまう。
ROOT="$(git rev-parse --show-toplevel)"

"$ROOT/tools/doclint.sh"
dotnet format "$ROOT/Godot3dFighter.sln" --verify-no-changes
dotnet build "$ROOT/Godot3dFighter.sln" -c Debug
dotnet test "$ROOT/tests/Core.Tests" -c Debug --no-build
